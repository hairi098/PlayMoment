# Salin file ini jadi .env lalu isi nilainya. JANGAN commit file .env.

# URL publik website — dipakai untuk OG Image & link preview di WhatsApp/Telegram
NUXT_PUBLIC_SITE_URL=https://playmoment.id

# URL project Supabase (opsional — kalau kosong pakai default di server/utils/supabase.ts)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Service Role Key — HANYA untuk server-side (jangan expose ke client!)
# Dapatkan di: Supabase Dashboard -> Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=

# Secret untuk menandatangani token login. WAJIB di production, minimal 32 karakter acak.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
